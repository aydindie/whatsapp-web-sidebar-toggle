{
  "manifest_version": 3,
  "name": "WhatsApp Web Sidebar Toggle",
  "description": "Toggle the left sidebar in WhatsApp Web with a button or Ctrl+B",
  "version": "1.1.0",
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
